    "version": "0.2.0",
    "configurations": [
        {
            "name": "TRBL Summarizer",
            "type": "python",
            "request": "launch",
            "program": ".venv/Scripts/streamlit.exe",
            "args": [
                "run",
                "TRBLSummarizer/trbl_summarizer.py"
            ],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name":"debug 2_make_tasks.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}\\TRBLSummarizer\\2_make_tasks.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}\\TRBLSummarizer\\;"
            }

        },
    ]
}